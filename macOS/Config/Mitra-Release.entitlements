<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	For downloadable releases, which are signed ad hoc rather than with an Apple Developer ID.
	App Groups and Keychain sharing need a provisioning profile, so they're left out: the app
	keeps its data to itself, and the widget extension (which relies on them) isn't shipped.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
