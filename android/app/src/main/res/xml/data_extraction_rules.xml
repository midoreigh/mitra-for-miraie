<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: the stored login is encrypted with a key that never leaves this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
