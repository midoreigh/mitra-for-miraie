<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="power_on" android:icon="@drawable/ic_shortcut_power"
        android:shortcutShortLabel="@string/shortcut_on_short" android:shortcutLongLabel="@string/shortcut_on">
        <intent android:action="com.midoreigh.mitra.POWER_ON" android:targetPackage="com.midoreigh.mitra"
            android:targetClass="com.midoreigh.mitra.MainActivity" />
